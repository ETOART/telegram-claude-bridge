# tg_claude_bot — environment variables
#
#   cp .env.example .env
#
# The script loads .env from its own directory on startup, so it does not
# matter which directory you run it from. Real environment variables win over
# the file, which keeps `TELEGRAM_BOT_TOKEN=... python tg_claude_bot.py` and
# `docker run --env-file` working as overrides.
#
# Every variable except TELEGRAM_BOT_TOKEN is optional; the values shown are
# the built-in defaults.

# --- Required ---------------------------------------------------------------

# Token from @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# --- Access ------------------------------------------------------------------

# Comma-separated Telegram user IDs allowed to use the bot, in any chat.
# Empty (the default) lets everyone in. The check is per user, not per chat,
# so adding the bot to a group does not grant access to its members.
# Find your ID by sending /start to the bot — it replies with user_id.
ALLOWED_USERS=

# Comma-separated group chat IDs (usually negative) where ANY member may talk to
# the bot. Slash commands and the system prompt stay limited to ALLOWED_USERS.
# Find a group's chat_id by sending /start in it — the reply shows chat_id.
ALLOWED_GROUPS=

# How long to stay quiet before telling the same person in the same chat again
# that their message was ignored, in seconds. Keeps a group with privacy mode
# off from filling up with refusals. 0 answers every time.
DENY_NOTICE_COOLDOWN_S=600

# --- Claude Code process ----------------------------------------------------

# Path to the claude executable, if it is not on PATH.
CLAUDE_BIN=claude

# Model for new chats. Accepts opus / sonnet / haiku or a full name such as
# claude-sonnet-4-6. Leave empty to let Claude Code pick.
CLAUDE_MODEL=sonnet

# Default working directory of the claude process, used by chats that have not
# set one with /cd. --resume is bound to this path: saved sessions are not
# found if the directory changes.
CLAUDE_WORKDIR=.

# Base for relative paths in /cd. Absolute paths and ~ bypass it.
# Defaults to CLAUDE_WORKDIR.
PROJECT_BASE_DIR=

# Confine /cd to PROJECT_BASE_DIR and its subdirectories. Off by default.
# There is no chat_id filter, so anyone who finds the bot can set the
# directory; turn this on to bound what they can reach.
PROJECT_STRICT=0

# Extra flags passed to claude, e.g. --mcp-config ./mcp.json
CLAUDE_EXTRA_ARGS=

# Max size of a single stdout line from claude's stream-json output, in bytes.
# Raise it if turns fail with "Separator is found, but chunk is longer than
# limit" — a tool returned more text than fits in one line at the current
# limit (e.g. reading a large file).
STDOUT_LINE_LIMIT=10485760

# Base part of the system prompt, passed via --append-system-prompt.
# Defaults to Telegram formatting instructions. Set to an empty value to drop
# it (also the first thing to try if the process exits right after start).
# CLAUDE_SYSTEM_APPEND=

# On a server, authenticate with a token from `claude setup-token` instead of
# a local interactive login.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- State ------------------------------------------------------------------

# SQLite file holding per-chat settings and chat -> session_id bindings.
STATE_DB=state.db

# Max age of a session still eligible for --resume, in seconds. Older sessions
# start fresh.
RESUME_MAX_AGE_S=7200

# --- Context ----------------------------------------------------------------

# Model context window, used by /context and the fill-up warning.
CONTEXT_WINDOW=200000

# Fill ratio at which the warning is emitted, once per session.
CONTEXT_WARN_RATIO=0.7

# --- Streaming --------------------------------------------------------------

# Stream the answer into the message as it is generated. 0 sends it in one go.
STREAMING=1

# Minimum interval between message edits, in seconds. Telegram starts
# returning 429 at roughly one edit per second.
EDIT_INTERVAL_S=1.1

# --- Throughput -------------------------------------------------------------

# Concurrent generations across all chats.
MAX_CONCURRENT_TURNS=2

# Pause after the last message before the batch is handed to the process.
DEBOUNCE_S=1.2

# Idle time before the process is shut down, in seconds.
IDLE_TIMEOUT_S=900

# Hard limit on a single turn, in seconds.
TURN_TIMEOUT_S=180

# --- Logging ----------------------------------------------------------------

# DEBUG also prints the claude process stderr and usage events.
LOG_LEVEL=INFO
